# Copy to .env (local) or .env.production / .env.testnet. Never commit real values.
NODE_ENV=development
APP_ENV=local
PORT=4000
WEB_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://blindcount:blindcount@localhost:5433/blindcount
STORAGE_DIR=../../storage

# Generate these with: pnpm --filter @blindcount/api keys:generate <file>
SESSION_SECRET=SET_48_RANDOM_BYTES
ENVELOPE_ENCRYPTION_KEY=BASE64_32_BYTES
CRITERION_ENCRYPTION_KEY=BASE64_32_BYTES_DIFFERENT_FROM_ENVELOPE_KEY
REPORT_SIGNING_JWK='{"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}'

# Chain. Local: Anvil. Testnet: Base Sepolia (chain id 84532).
CHAIN_ID=31337
CHAIN_NAME=Anvil (local)
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_PUBLIC_RPC_HINT=http://127.0.0.1:8545
CHAIN_EXPLORER_URL=
CHAIN_REGISTRY_ADDRESS=SET_AFTER_DEPLOY
CHAIN_RELAYER_PRIVATE_KEY=STORE_IN_SECRET_MANAGER
CHAIN_VOID_APPROVER_PRIVATE_KEY=DIFFERENT_KEY_FROM_RELAYER
CHAIN_CONFIRMATIONS=1
# Optional for deploys: CHAIN_DEPLOYER_PRIVATE_KEY, CHAIN_ADMIN_ADDRESS (multisig)

# AI evidence checks (advisory, off by default)
AI_ENABLED=false
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1/chat/completions
AI_MODEL=CONFIGURE_AND_PIN
AI_API_KEY=

EMAIL_PROVIDER=console
RUN_WORKER_IN_PROCESS=true
LOG_LEVEL=info

# Web (apps/web): rewrites are resolved at BUILD time, so set this before `next build`.
API_INTERNAL_URL=http://127.0.0.1:4000
