{
  "name": "@blindcount/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker-main.ts",
    "seed:demo": "tsx --env-file=../../.env scripts/seed-demo.ts",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "check-env": "tsx --env-file-if-exists=../../.env scripts/check-env.ts",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blindcount/contracts": "workspace:*",
    "@blindcount/crypto": "workspace:*",
    "@blindcount/db": "workspace:*",
    "@blindcount/domain": "workspace:*",
    "@fastify/cookie": "11.0.1",
    "@fastify/rate-limit": "10.2.1",
    "fastify": "5.2.0",
    "fflate": "0.8.2",
    "pdfkit": "0.15.2",
    "viem": "2.21.54",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pdfkit": "0.13.8",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
